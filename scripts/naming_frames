done
for f in ~/ag_bot/DINOv3-Segmentation-Training/Annotated/Output/2026-06-11-11-47-03/*.png; do
  cp "$f" ~/ag_bot/DINOv3-Segmentation-Training/annotations_combined/masks/v1_$(basename "$f")
done

# batch 2 -> master pool, prefixed v2_
for f in ~/ag_bot/DINOv3-Segmentation-Training/Annotated/Images/2026-06-11-11-53-20/*.jpg; do
